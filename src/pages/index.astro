---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  locale="en"
  description="Hands-on AI experiments, local models, OpenCode tutorials, and notes on crypto and technology investing. 提供中文与英文版本的工程实践与思考笔记。"
>
  <section class="py-12 sm:py-20">
    <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-100">
      DevLog <span lang="zh-CN" class="text-zinc-500 dark:text-zinc-400">/ 研发手记</span>
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-zinc-600 dark:text-zinc-300">
      Hands-on AI experiments and engineering tutorials, alongside notes on crypto and technology investing.
    </p>
    <p lang="zh-CN" class="mt-3 max-w-2xl text-lg leading-relaxed text-zinc-600 dark:text-zinc-300">
      记录本地模型、AI Agent 与 OpenCode 的工程实践，也分享加密经济与科技投资的思考。
    </p>
    <nav aria-label="Choose a language / 选择语言" class="mt-8 flex flex-wrap gap-4">
      <a href="/en/" hreflang="en" class="rounded-lg bg-indigo-600 px-6 py-3 font-semibold text-white hover:bg-indigo-700 transition-colors">
        Read in English →
      </a>
      <a href="/zh/" hreflang="zh-CN" lang="zh-CN" class="rounded-lg border border-zinc-300 px-6 py-3 font-semibold text-zinc-800 hover:border-indigo-500 hover:text-indigo-600 dark:border-zinc-700 dark:text-zinc-200 dark:hover:text-indigo-400 transition-colors">
        阅读中文版 →
      </a>
    </nav>
  </section>
</BaseLayout>
