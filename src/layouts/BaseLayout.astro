---
import '@/styles/global.css';
import type { Locale } from '@/utils/i18n';
import { uiStrings } from '@/utils/i18n';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

interface Props {
  title?: string;
  seoTitle?: string;
  description?: string;
  locale: Locale;
  canonicalURL?: string;
  ogImage?: string;
  alternateUrl?: string;
  alternateLang?: string;
  article?: {
    publishedTime: Date;
    modifiedTime?: Date;
    tags?: string[];
  };
}

const {
  title,
  seoTitle,
  description,
  locale,
  canonicalURL = Astro.url.href,
  ogImage = '/og-default.png',
  alternateUrl,
  alternateLang,
  article
} = Astro.props;

const t = uiStrings[locale];
const searchTitle = seoTitle ?? title;
const pageTitle = searchTitle ? `${searchTitle} | ${t.siteTitle}` : t.siteTitle;
const pageDescription = description || t.siteDescription;
const ogImageURL = new URL(ogImage, Astro.url).href;
const hreflangOf = (lang: string) => (lang === 'zh' ? 'zh-CN' : 'en');

// hreflang must point each page at its own translation (and itself). Posts pass their
// translation via alternateUrl; section pages exist under both locale prefixes.
const otherLocale = locale === 'en' ? 'zh' : 'en';
const siteURL = new URL('/', Astro.site).href;
const isRoot = Astro.url.pathname === '/';
const isLanguageHome = /^\/(en|zh)\/$/.test(Astro.url.pathname);
const sectionMatch = Astro.url.pathname.match(/^\/(en|zh)\/((?:blog|about|tags)\/)?$/);
const alternates: { lang: string; href: string }[] = [];
if (isRoot) {
  alternates.push({ lang: 'en', href: new URL('/en/', Astro.site).href });
  alternates.push({ lang: 'zh', href: new URL('/zh/', Astro.site).href });
} else if (alternateUrl && alternateLang) {
  alternates.push({ lang: locale, href: new URL(Astro.url.pathname, Astro.site).href });
  alternates.push({ lang: alternateLang, href: new URL(alternateUrl, Astro.site).href });
} else if (sectionMatch) {
  const rest = sectionMatch[2] ?? '';
  alternates.push({ lang: locale, href: new URL(`/${locale}/${rest}`, Astro.site).href });
  alternates.push({ lang: otherLocale, href: new URL(`/${otherLocale}/${rest}`, Astro.site).href });
}
const xDefault = alternates.find(a => a.lang === 'en');
const xDefaultURL = isRoot || isLanguageHome ? siteURL : xDefault?.href;

const jsonLd = article && {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: pageDescription,
  image: ogImageURL,
  url: canonicalURL,
  mainEntityOfPage: canonicalURL,
  inLanguage: hreflangOf(locale),
  datePublished: article.publishedTime.toISOString(),
  dateModified: (article.modifiedTime ?? article.publishedTime).toISOString(),
  keywords: article.tags?.join(', '),
  author: { '@type': 'Organization', name: t.siteTitle, url: siteURL },
  publisher: { '@type': 'Organization', name: t.siteTitle, url: siteURL }
};
const websiteJsonLd = isRoot && {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: uiStrings.en.siteTitle,
  alternateName: uiStrings.zh.siteTitle,
  url: siteURL
};
---

<!doctype html>
<html lang={locale === 'zh' ? 'zh-CN' : 'en'} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {isRoot && <meta name="google-site-verification" content="J0p_EaSURPQOajJsy1R5M4lJcxfOdweZR-LOc3ixH4A" />}

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Bilingual Hreflang SEO -->
    {alternates.map(a => <link rel="alternate" hreflang={hreflangOf(a.lang)} href={a.href} />)}
    {xDefaultURL && <link rel="alternate" hreflang="x-default" href={xDefaultURL} />}

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={t.siteTitle} />
    <meta property="og:locale" content={locale === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {article && <meta property="article:published_time" content={article.publishedTime.toISOString()} />}
    {article?.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />}
    {article?.tags?.map(tag => <meta property="article:tag" content={tag} />)}

    <!-- Twitter Cards / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Structured data (Google rich results) -->
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {websiteJsonLd && <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />}

    <!-- RSS Autodiscovery -->
    <link rel="alternate" type="application/rss+xml" title={`${t.siteTitle} RSS (${locale.toUpperCase()})`} href={`/${locale}/rss.xml`} />

    <!-- FOUC Prevention Script -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();

      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="flex flex-col min-h-screen">
    <Header locale={locale} currentPath={Astro.url.pathname} alternateUrl={alternateUrl} />
    <main class="flex-grow max-w-4xl w-full mx-auto px-4 sm:px-6 py-8">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
